{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/join", "destination": "/index.html" },
    { "source": "/room/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https: wss:; img-src 'self' https:; media-src 'self' https:; form-action 'self' https:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'" }
      ]
    }
  ]
}
